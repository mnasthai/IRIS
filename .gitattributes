# ============================================================
# 行尾策略
#   仓库内与检出统一使用 LF，避免 Windows / Linux 协作时
#   因 core.autocrlf 差异产生整文件换行 churn。
# ============================================================
* text=auto eol=lf

# 二进制资源不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.gif   binary
*.silk  binary
*.wxgf  binary

# ============================================================
# 第三方依赖
#   以 -text 关闭行尾转换，保证 vendored 文件与上游字节一致，
#   便于对照上游做 diff，也避免"修改了第三方文件"的疑虑。
# ============================================================
third_party/** -text

# 不计入仓库语言统计
third_party/minhook/** linguist-vendored
